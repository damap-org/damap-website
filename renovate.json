{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "ignoreUnstable": true,
  "commitMessagePrefix": "Docs(index.md):",
  "commitMessageLowerCase": "never",
  "commitMessageAction": "bump",
  "commitMessageTopic": "DAMAP release label",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update the homepage's latest DAMAP release label",
      "managerFilePatterns": ["/^docs/index\\.md$/"],
      "matchStrings": [
        "href=\"https://github\\.com/damap-org/damap-backend/releases/latest\"[^>]*>DAMAP (?<currentValue>v?\\d+\\.\\d+\\.\\d+)</a>"
      ],
      "depNameTemplate": "damap-org/damap-backend",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    }
  ]
}
